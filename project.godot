; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="O Homem De Metas"
config/description="Um jogo de horror psicologico baseado em stalking real."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

PedestreManager="*res://scripts/pedestre_manager.gd"
CarroManager="*res://autoload/carro_manager.gd"
GameManager="*res://autoload/game_manager.gd"
GameState="*res://autoload/game_state.gd"
Inventario="*res://scripts/inventario.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input]

